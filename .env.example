# Base URL for the booking/provider API (mock in this build; point to your backend later)
VITE_API_BASE_URL=https://api.wisecare.health

# Public payment gateway key (Paystack) — safe to expose client-side
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Maps / tracking provider key, if wired up later
VITE_MAPS_API_KEY=

# Analytics id, if wired up later
VITE_ANALYTICS_ID=
